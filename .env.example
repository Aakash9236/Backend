# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=service_platform_db
DB_USER=postgres
DB_PASSWORD=Kaynex@123

# Database URL for Prisma / ORM
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# Redis Configuration (Local)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT & Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_super_secure_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_super_secure_key
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Mock OTP for Local Development
MOCK_OTP_ENABLED=true
DEV_DEFAULT_OTP=123456

