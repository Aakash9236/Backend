# =====================================================================
# MULTI-SERVICE ON-DEMAND PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to .env and configure your local credentials.

# 1. Server Configuration
PORT=5000
NODE_ENV=development

# 2. PostgreSQL 18 Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=service_platform_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Full Prisma / Database Connection String
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# 3. Redis Configuration (Optional for Local Development)
# If local Redis is offline, the backend starts in degraded mode with clear logging.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 4. Authentication & Security Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_16_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_16_characters_long
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# 5. Mock OTP Mode (For Local Development Only)
MOCK_OTP_ENABLED=true
DEV_DEFAULT_OTP=123456
